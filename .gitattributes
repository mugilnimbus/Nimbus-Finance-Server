.gitignore text eol=lf
.gitattributes text eol=lf
*.svg text eol=lf

*.kt text eol=lf
*.kts text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf
gradlew text eol=lf

*.ps1 text eol=crlf
